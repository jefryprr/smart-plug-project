# Application
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Authentication (development only; replace in staging/production)
JWT_SECRET=dev-only-change-me-32-characters-minimum
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Database
# The local test server uses Node's built-in SQLite. PostgreSQL is the target deployment database.
DATABASE_URL=postgres://smartplug:smartplug@localhost:5432/smartplug
SQLITE_PATH=./data/smartplug.db

# MQTT
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_REJECT_UNAUTHORIZED=true

# Telegram (optional; leave empty to use the mock provider)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public URLs (never include secrets)
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# Device simulator
SIM_DEVICE_ID=dev-sim-001
SIM_TELEMETRY_INTERVAL_MS=2000
SIM_START_STATE=OFF
