{
  "name": "@smartplug/device-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/simulator.js",
  "types": "./dist/simulator.d.ts",
  "exports": {
    ".": {
      "types": "./dist/simulator.d.ts",
      "import": "./dist/simulator.js"
    },
    "./simulator": {
      "types": "./dist/simulator.d.ts",
      "import": "./dist/simulator.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@smartplug/domain": "*",
    "@smartplug/mqtt-contract": "*",
    "mqtt": "^5.16.1",
    "zod": "^4.6.7"
  }
}
