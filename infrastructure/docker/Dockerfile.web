# syntax=docker/dockerfile:1
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/device-simulator/package.json apps/device-simulator/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/api-contract/package.json packages/api-contract/package.json
COPY packages/mqtt-contract/package.json packages/mqtt-contract/package.json
RUN npm ci --no-audit --no-fund
COPY tsconfig.base.json ./
COPY packages packages
COPY apps/web apps/web
ENV PUBLIC_API_URL=http://api:4000
RUN npm run build -w @smartplug/domain \
 && npm run build -w @smartplug/api-contract \
 && npm run build -w @smartplug/web

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/packages packages
COPY --from=build /app/apps/web apps/web
EXPOSE 3000
CMD ["npm", "run", "start", "-w", "@smartplug/web"]
